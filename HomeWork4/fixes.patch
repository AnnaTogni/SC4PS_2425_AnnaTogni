+static int write_modes_csv(const char *path, double f_in_phase, double f_out_of_phase)
+{
+    FILE *fp = fopen(path, "w");
+
+    if (fp == NULL) {
+        return -1;
+    }
+
+    fprintf(fp, "mode,frequency_hz\n");
+    fprintf(fp, "in_phase,%.12f\n", f_in_phase);
+    fprintf(fp, "out_of_phase,%.12f\n", f_out_of_phase);
+
+    fclose(fp);
+    return 0;
+}
